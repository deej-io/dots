#!/bin/sh

show_error() {
    msg="$1"
    if command -v swaynag >/dev/null 2>&1; then
        swaynag -t error -m "$msg" >/dev/null 2>&1 &
        return
    fi

    if command -v notify-send >/dev/null 2>&1; then
        notify-send "Sway" "$msg" >/dev/null 2>&1
        return
    fi

    printf '%s\n' "$msg" >&2
}

for term in ghostty kitty foot; do
    if command -v "$term" >/dev/null 2>&1; then
        exec "$term" "$@"
    fi
done

show_error 'No supported terminal found: ghostty, kitty, foot.'

exit 1
